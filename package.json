{
  "name": "cv-pdf-generator",
  "version": "1.0.0",
  "description": "Converts HTML CV to PDF with A4 size",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "pdf": "node src/index.js",
    "pdf:crypto": "node src/index.js CV_Gustavo_Sena_Crypto",
    "pdf:general": "node src/index.js CV_Gustavo_Sena",
